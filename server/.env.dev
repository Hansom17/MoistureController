# Local development on one machine: `docker compose --env-file .env.dev up`.
# Dev auth accepts unsigned `Bearer dev:<uid>` tokens — never on a public host.
MC_AUTH_MODE=dev
MC_BROKER_PUBLIC_HOST=localhost
MC_BROKER_PUBLIC_PORT=8883
MC_PUBLIC_API_URL=http://localhost:8000
MC_APP_URL=http://localhost:8420
MC_CORS_ORIGINS=http://localhost:8420
MC_API_BIND=127.0.0.1:8000
