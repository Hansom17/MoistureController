# Copy to .env (Api_Specs §13.1).
MC_BROKER_PUBLIC_HOST=mqtt.example.com
MC_BROKER_PUBLIC_PORT=8883
MC_PUBLIC_API_URL=https://api.example.com
MC_APP_URL=https://app.example.com
MC_CORS_ORIGINS=https://app.example.com
MC_API_HOST=api.example.com

# "dev" accepts unsigned `Bearer dev:<uid>` tokens: local development ONLY.
MC_AUTH_MODE=firebase
MC_FIREBASE_PROJECT_ID=
# Path inside the container, e.g. /run/firebase/service-account.json
MC_FIREBASE_CREDENTIALS=

# Where the API port is published.
MC_API_BIND=127.0.0.1:8000

# Phase 1 (Raspberry Pi): Cloudflare Tunnel token for `--profile tunnel`.
MC_CLOUDFLARE_TUNNEL_TOKEN=
