menu "PlantModule Zigbee"

    config MC_ZIGBEE_STUB
        bool "Use the stub instead of the Zigbee stack (bench tests without a radio)"
        default n

    config MC_ZB_TX_POWER
        int "Zigbee transmit power in dBm"
        range -24 20
        default 10
        help
            Lower values draw less current, which matters on a weak USB supply during bench tests.

endmenu
