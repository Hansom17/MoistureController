# Hub next to the local cloud stack on the same Mac (server/.env.dev).
# The cloud broker already uses 8883, so the hub's device port is 18883.
MC_CLOUD_API_URL=http://host.docker.internal:8000
MC_CLOUD_MQTT_HOST_OVERRIDE=host.docker.internal
MC_LAN_HOST=localhost
MC_LAN_PORT=18883
MC_LAN_BIND=127.0.0.1
