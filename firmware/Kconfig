# MoistureController application options (the rest is Zephyr's).
mainmenu "MoistureController firmware"

menu "MoistureController"

config MC_DEV_PROVISION
	bool "Provision from this build (development only)"
	help
	  Stores WiFi, broker and key from the options below on first boot, so the device
	  can run on the bench before BLE pairing (contracts/ble.md) exists. The values end
	  up in the firmware image: never use it for devices you hand to someone.

if MC_DEV_PROVISION

config MC_DEV_WIFI_SSID
	string "WiFi network"

config MC_DEV_WIFI_PASSWORD
	string "WiFi password"

config MC_DEV_BROKER_HOST
	string "Gateway LAN address"
	help
	  As shown by `mc-gateway status`, or in the app's gateway screen.

config MC_DEV_BROKER_PORT
	int "Broker port"
	default 8883

config MC_DEV_DEVICE_ID
	string "Device ID"
	help
	  mc-... from the pairing bundle (`mc-api seed-dev` prints one).

config MC_DEV_PSK_HEX
	string "TLS-PSK key (64 hex characters)"

endif # MC_DEV_PROVISION

config MC_DEV_POP_HEX
	string "Development PoP (32 hex characters), used if the factory partition is blank"
	default ""
	help
	  Real devices get their PoP from the factory partition (firmware/tools/make_label.py).
	  For a bench board without one, this lets the pairing window open anyway.

config MC_LOW_TX_POWER
	bool "Low radio transmit power (bench: weak USB supply)"
	help
	  Bluetooth -9 dBm, WiFi 8 dBm instead of the defaults. On a weak USB port or cable the
	  supply dips when the radio transmits, which resets the USB serial chip (or the board).
	  Also fine next to the gateway; it lowers the range.

config MC_WIFI_DIAG
	bool "Scan and log the visible WiFi networks when joining fails"
	help
	  Costs a few seconds per failed cycle: for bring-up, not for the field.

config MC_NTP_SERVER
	string "NTP server"
	default "pool.ntp.org"
	help
	  Needed to check command expiry. Open point: the gateway could serve the time
	  instead, so devices need no internet (contracts/mqtt.md §11).

config MC_BATT_ADC_PIN
	int "Battery voltage ADC pin (-1: not measured)"
	default -1
	help
	  Must be an ADC1 pin (32-39) not used by a module slot, wired to the battery through a
	  voltage divider. An unconnected pin floats and reads as a low battery: leave this at -1
	  until the divider is there.

config MC_BATT_DIVIDER_PERCENT
	int "Battery divider factor in percent"
	default 200
	help
	  200 = two equal resistors (the ADC sees half the battery voltage).

config MC_BUTTON_SERVICE_MINUTES
	int "Service mode length after a BOOT button wake"
	default 15

endmenu

source "Kconfig.zephyr"
