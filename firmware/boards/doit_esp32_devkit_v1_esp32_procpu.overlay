/*
 * Moisture controller on the DOIT ESP32 DevKit V1.
 *
 * Module pins are NOT fixed here: they come from the config and are bound at runtime
 * (Firmware_Specs "Module system"). The overlay only enables what they need.
 */

/ {
	aliases {
		retainedmemdevice = &retainedmem0;
	};

	/* 4 KB of RTC slow RAM keep the cycle state through deep sleep (src/core/mc_rtc.h). */
	memory@50001000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x50001000 0x1000>;
		zephyr,memory-region = "RTC_SLOW_RAM_RETAINED_MEM";
		status = "okay";

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};
};

&rtc_slow_ram {
	/* 8 KB minus the retained 4 KB */
	reg = <0x50000000 0x1000>;
};

/* ADC1 (GPIO 32-39) and ADC2 (GPIO 4, 12-15, 25-27): channels are set up at runtime. */
&adc0 {
	status = "okay";
};

&adc1 {
	status = "okay";
};
