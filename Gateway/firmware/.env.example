# Copy to .env (scripts/setup.sh does that and fills in the passwords).

# The Zigbee coordinator on this host. Prefer the stable by-id path.
ZIGBEE_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_XXXX-if00-port0
ZIGBEE_ADAPTER=ember

# Port of the web app and API on this host.
MC_PORT=80
# Flutter web build to serve (flutter build web --release in App/).
WEB_DIR=../../App/build/web
MC_INSTANCE_ID=api-1
MC_VERSION=dev

# MQTT passwords (generated by scripts/setup.sh)
MQTT_HUB_PASSWORD=
MQTT_API_PASSWORD=
MQTT_Z2M_PASSWORD=
